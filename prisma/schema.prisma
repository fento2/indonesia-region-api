generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id         String    @id
  email      String    @unique
  username   String    @unique
  name       String
  phone      String
  gender     Gender
  isVeridied DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  password   String
}

enum Gender {
  Male
  Female
}
